						"url": {
							"raw": "{{base_url}}/api/upload/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"upload",
								""
							]
						},
						"description": "محاولة رفع صورة لألبوم غير موجود (يجب أن يفشل)"
